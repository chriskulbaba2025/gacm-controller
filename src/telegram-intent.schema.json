{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "action",
    "tranche",
    "objective",
    "run_id",
    "confidence",
    "clarification"
  ],
  "properties": {
    "project": {
      "type": ["string", "null"],
      "enum": ["prysm", "gacm", "sandbox", "falardeau", null]
    },
    "action": {
      "type": "string",
      "enum": ["status", "details", "run", "stop", "publish", "clarify"]
    },
    "tranche": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "objective": {
      "type": ["string", "null"],
      "maxLength": 3000
    },
    "run_id": {
      "type": ["string", "null"],
      "maxLength": 180
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "clarification": {
      "type": ["string", "null"],
      "maxLength": 500
    }
  }
}
